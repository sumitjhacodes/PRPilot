generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReviewStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum FindingSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  name         String?
  githubUserId BigInt?  @unique
  githubLogin  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  installations Installation[]
}

model Installation {
  id                   String   @id @default(cuid())
  userId               String?
  githubInstallationId BigInt   @unique
  accountLogin         String
  accountType          String // Organization | User
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user         User?        @relation(fields: [userId], references: [id])
  repositories Repository[]

  @@index([userId])
}

model Repository {
  id             String   @id @default(cuid())
  installationId String
  githubRepoId   BigInt   @unique
  owner          String
  name           String
  fullName       String
  defaultBranch  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  installation Installation  @relation(fields: [installationId], references: [id])
  pullRequests PullRequest[]

  @@unique([owner, name])
  @@index([installationId])
}

model PullRequest {
  id           String   @id @default(cuid())
  repositoryId String
  githubPrId   BigInt
  number       Int
  title        String
  body         String?
  state        String // open | closed | merged
  headSha      String
  baseSha      String
  authorLogin  String?
  htmlUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id])
  reviews    Review[]

  @@unique([repositoryId, number])
  @@index([githubPrId])
}

model Review {
  id            String       @id @default(cuid())
  pullRequestId String
  status        ReviewStatus @default(QUEUED)
  summary       String?
  model         String?
  errorMessage  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id])
  findings    Finding[]

  @@index([pullRequestId, createdAt])
  @@index([status])
}

model Finding {
  id          String          @id @default(cuid())
  reviewId    String
  severity    FindingSeverity
  category    String?
  title       String
  explanation String
  suggestion  String?         
  filePath    String?
  startLine   Int?
  endLine     Int?
  createdAt   DateTime        @default(now())

  review Review @relation(fields: [reviewId], references: [id])

  @@index([reviewId])
}
